{
  "name": "@ektie/react-video-timeline-editor",
  "version": "0.1.0",
  "description": "Open-source React multi-track video timeline editor",
  "license": "AGPL-3.0",
  "author": "Ektie",
  "homepage": "https://github.com/Ektie/react-video-timeline-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ektie/react-video-timeline-editor.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/Ektie/react-video-timeline-editor/issues"
  },
  "keywords": [
    "react",
    "video",
    "timeline",
    "editor",
    "nle",
    "multitrack",
    "nextjs"
  ],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "scripts": {
    "build": "vite build",
    "prepare": "vite build",
    "prepack": "vite build",
    "test": "node --test tests/*.test.js"
  }
}
