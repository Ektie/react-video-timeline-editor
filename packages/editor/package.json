{
  "name": "@ektie/react-video-timeline-editor",
  "version": "0.1.0",
  "description": "Open-source React multi-track video timeline editor",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js"
    },
    "./style.css": "./src/styles.css",
    "./src": "./src/index.js"
  },
  "files": ["dist", "src", "LICENSE", "NOTICE"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test tests/*.test.js"
  }
}
